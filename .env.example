# Copy to .env (or export in your shell) and adjust for your environment.
# With none of these set, the project runs in local development mode.

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_ALLOWED_HOSTS=shop.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
DJANGO_TIME_ZONE=Africa/Nairobi
DJANGO_SQLITE_PATH=/var/lib/mercyshop/db.sqlite3
DJANGO_MEDIA_ROOT=/var/lib/mercyshop/media
# Set to false when a proxy in front of Django already redirects to HTTPS.
DJANGO_SECURE_SSL_REDIRECT=true
